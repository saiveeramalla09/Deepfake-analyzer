{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "serverless": {
    "memory": 1024,
    "timeout": 60
  },
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.ts"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/dist/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.ts"
    }
  ]
}
